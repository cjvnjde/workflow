{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./web/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun", "node", "vite/client"],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "web", "tests", "scripts", "vite.config.ts", "vitest.config.ts"]
}
