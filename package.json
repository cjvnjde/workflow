{
  "name": "predictable-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI workflows with explicit graphs, full local tools and a live UI",
  "bin": {
    "workflow": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/implementation-plan.md"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "workflow": "bun src/cli.ts",
    "dev": "bun scripts/dev.ts",
    "dev:live": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "prepare": "bun run build",
    "start": "bun dist/cli.js",
    "test": "bun run build && bun test --timeout 30000 tests/*.test.ts",
    "test:e2e": "bun run build && bun --bun run playwright test",
    "test:live": "bun run build && bun scripts/live-smoke.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "format:web": "bun --bun run prettier --write \"web/**/*.vue\" \"web/composables/*.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@fastify/static": "^10.1.5",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "dompurify": "^3.4.17",
    "fastify": "^5.6.0",
    "markdown-it": "^15.0.3",
    "minimatch": "^10.2.0",
    "proper-lockfile": "4.1.2",
    "vue": "^3.5.44",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "4.1.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@volar/typescript": "2.4.28",
    "@vue/language-core": "3.3.13",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
