{
  "name": "predictable-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous AI workflows with explicit graphs, full local tools and a live UI",
  "bin": {
    "workflow": "dist/cli.js"
  },
  "exports": {
    "./workflow": {
      "types": "./dist/workflow-sdk.d.ts",
      "import": "./dist/workflow-sdk.js"
    },
    "./engine": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./http": {
      "types": "./dist/http-server.d.ts",
      "import": "./dist/http-server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js"
    }
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "docs/"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "workflow": "bun src/cli/index.ts",
    "dev": "bun scripts/dev.ts",
    "dev:live": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "prepare": "bun run build",
    "start": "bun dist/cli.js",
    "test": "bun run build && bun test --timeout 30000 tests/*.test.ts",
    "test:unit": "bun scripts/test-unit.ts",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "test:mutation:smoke": "stryker run stryker.smoke.config.mjs",
    "test:mutation:full": "stryker run stryker.full.config.mjs",
    "test:e2e": "bun run build && bun --bun run playwright test",
    "test:live": "bun run build && bun scripts/live-smoke.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "format:web": "prettier --write web",
    "build:engine": "bun scripts/build.ts --engine-only",
    "build:web": "bun --bun run vite build",
    "screenshot:terminal": "bun scripts/capture-terminal.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@fastify/static": "^10.1.5",
    "@lezer/highlight": "^1.2.5",
    "@opentui/core": "0.6.8",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fastify": "^5.6.0",
    "markdown-it": "^15.0.3",
    "minimatch": "^10.2.0",
    "prettier": "^3.9.10",
    "proper-lockfile": "4.1.2",
    "typescript": "^5.9.0",
    "vue": "^3.5.44",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.1.1",
    "@types/bun": "^1.4.2",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "4.1.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@volar/typescript": "2.4.28",
    "@vue/language-core": "3.3.13",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
