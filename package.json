{
  "name": "predictable-workflow",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "description": "Autonomous AI workflows with explicit graphs, full local tools and a live UI",
  "bin": {
    "workflow": "dist/cli.js"
  },
  "exports": {
    "./workflow": {
      "types": "./dist/workflow-sdk.d.ts",
      "import": "./dist/workflow-sdk.js"
    },
    "./engine": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./http": {
      "types": "./dist/http-server.d.ts",
      "import": "./dist/http-server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js"
    }
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "docs/"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "workflow": "bun src/cli/index.ts",
    "dev": "bun src/cli/index.ts --web",
    "dev:web": "vite",
    "build": "tsx scripts/build.ts",
    "compile": "npm run build && bun scripts/compile.ts",
    "test:standalone": "npm run compile && npm run test:standalone:run",
    "test:standalone:run": "bun node_modules/vitest/vitest.mjs run --project integration tests/standalone.test.ts --testTimeout 120000",
    "prepack": "npm run build",
    "start": "bun dist/cli.js",
    "test": "npm run build && npm run test:run",
    "test:run": "bun node_modules/vitest/vitest.mjs run --project unit --project runtime-unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest watch --project unit",
    "test:runtime:unit": "bun node_modules/vitest/vitest.mjs run --project runtime-unit",
    "test:runtime": "bun node_modules/vitest/vitest.mjs run --project runtime-unit --project integration",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "test:mutation:smoke": "stryker run stryker.smoke.config.mjs",
    "test:mutation:full": "stryker run stryker.full.config.mjs",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:visual": "npm run build && npm run test:e2e:run --grep @visual",
    "test:visual:update": "npm run build && npm run test:e2e:run --grep @visual --update-snapshots",
    "test:browser:install": "playwright install chromium",
    "test:live": "npm run build && bun scripts/live-smoke.ts",
    "typecheck": "tsc --project tsconfig.json",
    "format:web": "prettier --write web",
    "build:engine": "tsx scripts/build.ts --engine-only",
    "build:web": "vite build",
    "screenshot:terminal": "bun scripts/capture-terminal.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@fastify/static": "^10.1.8",
    "@lezer/highlight": "^1.2.5",
    "@opentui/core": "0.8.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.7",
    "lucide-react": "^1.66.0",
    "markdown-it": "^15.0.3",
    "minimatch": "11.0.3",
    "prettier": "^3.9.10",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stryker-mutator/core": "^10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@workflow/eslint": "file:tooling/eslint",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "rolldown": "~1.2.14",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "qs": "6.17.1",
    "undici": "8.12.3"
  }
}
