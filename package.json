{
  "name": "predictable-workflow",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "description": "Autonomous AI workflows with explicit graphs, full local tools and a live UI",
  "bin": {
    "workflow": "dist/cli.js"
  },
  "exports": {
    "./workflow": {
      "types": "./dist/workflow-sdk.d.ts",
      "import": "./dist/workflow-sdk.js"
    },
    "./engine": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./http": {
      "types": "./dist/http-server.d.ts",
      "import": "./dist/http-server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js"
    }
  },
  "files": [
    "dist/",
    "patches/",
    "examples/",
    "README.md",
    "docs/"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "workflow": "bun src/cli/index.ts",
    "dev": "bun scripts/dev.ts",
    "dev:live": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "compile": "bun run build && bun scripts/compile.ts",
    "test:standalone": "bun run compile && bun test --timeout 60000 tests/standalone.test.ts",
    "prepack": "bun run build",
    "start": "bun dist/cli.js",
    "test": "bun run build && bun test --timeout 30000 tests/*.test.ts",
    "test:unit": "bun scripts/test-unit.ts",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "test:mutation:smoke": "stryker run stryker.smoke.config.mjs",
    "test:mutation:full": "stryker run stryker.full.config.mjs",
    "test:e2e": "bun run build && bun --bun run playwright test",
    "test:live": "bun run build && bun scripts/live-smoke.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "format:web": "prettier --write web",
    "build:engine": "bun scripts/build.ts --engine-only",
    "build:web": "bun --bun run vite build",
    "screenshot:terminal": "bun scripts/capture-terminal.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@fastify/static": "^10.1.8",
    "@lezer/highlight": "^1.2.5",
    "@opentui/core": "0.8.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.7",
    "lucide-react": "^1.66.0",
    "markdown-it": "^15.0.3",
    "minimatch": "^11.0.3",
    "prettier": "^3.9.10",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.28.8",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "qs": "6.17.1",
    "undici": "8.12.3"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@1.4.0": "patches/@earendil-works%2Fpi-ai@1.4.0.patch"
  }
}
